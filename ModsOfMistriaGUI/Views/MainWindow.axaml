<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm="using:Garethp.ModsOfMistriaGUI.ViewModels"
        x:Class="Garethp.ModsOfMistriaGUI.Views.MainWindow"
        xmlns:lang="clr-namespace:Garethp.ModsOfMistriaInstallerLib.Lang;assembly=ModsOfMistriaInstallerLib"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/small_icon.png"
        Width="820" Height="600"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key='Light'>
                    <SolidColorBrush x:Key='IconColor'>Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key='Dark'>
                    <SolidColorBrush x:Key='IconColor'>White</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Image Source="/Assets/header.jpg" Height="145" MaxHeight="160" Stretch="UniformToFill"/>

        <Panel Grid.Row="1" Margin="32 16 32 0" ClipToBounds="True">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
        </Panel>

        <!-- An update is important, but it should not permanently take a row from the mod list. -->
        <Border Grid.Row="2"
                IsVisible="{Binding UpdateAvailable}"
                Background="#2D6B4A"
                CornerRadius="4"
                Padding="10 6"
                Margin="32 6 32 10"
                HorizontalAlignment="Right"
                MaxWidth="560">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding UpdateMessage}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding Texts.GUIGitHubButtonText}" Click="OpenGitHubClick" Margin="12 0 0 0" />
                    <Button Grid.Column="2"
                            Content="×"
                            Command="{Binding DismissUpdateCommand}"
                            FontSize="18"
                            Padding="6 0"
                            Margin="6 0 0 0" />
                </Grid>
        </Border>
    </Grid>
</Window>
